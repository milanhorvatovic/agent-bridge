{
  "name": "compact",
  "description": "a content-producing turn, /compact summarizing the conversation to its Context-compacted cell, then a turn on the compacted context",
  "cli": "codex",
  "args": ["-m", "gpt-5.5", "-c", "check_for_update_on_startup=false"],
  "steps": [
    { "wait_text": "trust", "timeout_ms": 20000, "label": "trust-dialog" },
    { "pause_ms": 1000 },
    { "press": "enter", "label": "trust-accept" },
    { "wait_quiet_ms": 1500, "timeout_ms": 45000, "label": "startup-settled" },
    { "type_line": "Write a five-sentence paragraph about the history of computer terminals.", "label": "turn-one" },
    { "wait_quiet_ms": 2500, "timeout_ms": 180000, "label": "turn-one-end" },
    { "type_line": "/compact", "label": "compact-command" },
    { "wait_text": "compacted", "timeout_ms": 120000, "label": "compacted" },
    { "wait_quiet_ms": 1500, "timeout_ms": 60000, "label": "post-compact-settled" },
    { "type_line": "Reply with exactly: done", "label": "turn-two" },
    { "wait_quiet_ms": 2500, "timeout_ms": 120000, "label": "turn-two-end" },
    { "type_line": "/quit", "label": "quit-command" }
  ]
}
