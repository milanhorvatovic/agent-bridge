{
  "args": ["-m", "gpt-5.5", "-c", "check_for_update_on_startup=false", "-a", "untrusted", "-s", "workspace-write"],
  "cli": "codex",
  "description": "exec-approval dialog answered by arrow-key navigation and enter; untrusted approval policy makes the touch command escalate to the menu",
  "name": "approval-arrow-key",
  "steps": [
    { "label": "trust-dialog", "timeout_ms": 20000, "wait_text": "trust" },
    { "pause_ms": 1000 },
    { "label": "trust-accept", "press": "enter" },
    { "label": "startup-settled", "timeout_ms": 45000, "wait_quiet_ms": 1500 },
    { "label": "tool-prompt", "type_line": "Use the shell to run exactly `touch marker.txt` to create an empty file in the current directory." },
    { "label": "approval-dialog", "timeout_ms": 120000, "wait_text": "proceed" },
    { "pause_ms": 1500 },
    { "label": "menu-move", "press": "down" },
    { "pause_ms": 400 },
    { "label": "menu-move-back", "press": "up" },
    { "pause_ms": 400 },
    { "label": "approve-selection", "press": "enter" },
    { "label": "turn-end", "timeout_ms": 120000, "wait_quiet_ms": 2500 },
    { "label": "quit-command", "type_line": "/quit" }
  ]
}
