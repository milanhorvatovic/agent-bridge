{
  "name": "approval-arrow-key",
  "description": "exec-approval dialog answered by arrow-key navigation and enter; untrusted approval policy makes the touch command escalate to the menu",
  "cli": "codex",
  "args": ["-m", "gpt-5.5", "-c", "check_for_update_on_startup=false", "-a", "untrusted", "-s", "workspace-write"],
  "steps": [
    { "wait_text": "trust", "timeout_ms": 20000, "label": "trust-dialog" },
    { "pause_ms": 1000 },
    { "press": "enter", "label": "trust-accept" },
    { "wait_quiet_ms": 1500, "timeout_ms": 45000, "label": "startup-settled" },
    { "type_line": "Use the shell to run exactly `touch marker.txt` to create an empty file in the current directory.", "label": "tool-prompt" },
    { "wait_text": "proceed", "timeout_ms": 120000, "label": "approval-dialog" },
    { "pause_ms": 1500 },
    { "press": "down", "label": "menu-move" },
    { "pause_ms": 400 },
    { "press": "up", "label": "menu-move-back" },
    { "pause_ms": 400 },
    { "press": "enter", "label": "approve-selection" },
    { "wait_quiet_ms": 2500, "timeout_ms": 120000, "label": "turn-end" },
    { "type_line": "/quit", "label": "quit-command" }
  ]
}
