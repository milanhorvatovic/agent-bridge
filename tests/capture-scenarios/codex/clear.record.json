{
  "args": ["-m", "gpt-5.5", "-c", "check_for_update_on_startup=false"],
  "cli": "codex",
  "description": "a completed turn, /clear starting a new chat, then a second turn — codex's session-reset surface, turn ends by quiescence",
  "name": "clear",
  "steps": [
    { "label": "trust-dialog", "timeout_ms": 20000, "wait_text": "trust" },
    { "pause_ms": 1000 },
    { "label": "trust-accept", "press": "enter" },
    { "label": "startup-settled", "timeout_ms": 45000, "wait_quiet_ms": 1500 },
    { "label": "turn-one", "type_line": "Reply with exactly: ok" },
    { "label": "turn-one-end", "timeout_ms": 120000, "wait_quiet_ms": 2500 },
    { "label": "clear-command", "type_line": "/clear" },
    { "label": "cleared", "timeout_ms": 30000, "wait_quiet_ms": 1500 },
    { "label": "turn-two", "type_line": "Reply with exactly: ok again" },
    { "label": "turn-two-end", "timeout_ms": 120000, "wait_quiet_ms": 2500 },
    { "label": "quit-command", "type_line": "/quit" }
  ]
}
