{
  "name": "clear",
  "description": "a completed turn, /clear starting a new chat, then a second turn — codex's session-reset surface, turn ends by quiescence",
  "cli": "codex",
  "args": ["-m", "gpt-5.5", "-c", "check_for_update_on_startup=false"],
  "steps": [
    { "wait_text": "trust", "timeout_ms": 20000, "label": "trust-dialog" },
    { "pause_ms": 1000 },
    { "press": "enter", "label": "trust-accept" },
    { "wait_quiet_ms": 1500, "timeout_ms": 45000, "label": "startup-settled" },
    { "type_line": "Reply with exactly: ok", "label": "turn-one" },
    { "wait_quiet_ms": 2500, "timeout_ms": 120000, "label": "turn-one-end" },
    { "type_line": "/clear", "label": "clear-command" },
    { "wait_quiet_ms": 1500, "timeout_ms": 30000, "label": "cleared" },
    { "type_line": "Reply with exactly: ok again", "label": "turn-two" },
    { "wait_quiet_ms": 2500, "timeout_ms": 120000, "label": "turn-two-end" },
    { "type_line": "/quit", "label": "quit-command" }
  ]
}
