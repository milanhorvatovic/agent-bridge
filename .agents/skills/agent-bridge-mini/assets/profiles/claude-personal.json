{
  "description": "Claude Code (personal subscription) — Opus 4.7 + xhigh",
  "command": ["claude", "--print"],
  "prompt_mode": "stdin",
  "model": "claude-opus-4-7",
  "effort": "xhigh",
  "model_args": ["--model", "{value}"],
  "effort_args": ["--effort", "{value}"],
  "skill_format": "/{name}",
  "env": {
    "CLAUDE_CONFIG_DIR": "$HOME/.claude-personal"
  }
}
