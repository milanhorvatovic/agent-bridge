{
  "description": "Kimi K2.6 routed through OpenCode (personal subscription, kimi-for-coding)",
  "command": ["opencode", "run"],
  "prompt_mode": "arg",
  "model": "kimi-for-coding/k2p6",
  "model_args": ["--model", "{value}"],
  "effort_args": null,
  "skill_format": "/{name}",
  "env": {
    "OPENCODE_PROFILE": "personal",
    "XDG_DATA_HOME": "$HOME/.local/share-personal",
    "OPENCODE_CONFIG": "$HOME/.config/opencode-profiles/personal/opencode.json",
    "OPENCODE_CONFIG_DIR": "$HOME/.config/opencode-profiles/personal",
    "OPENCODE_TUI_CONFIG": "$HOME/.config/opencode-profiles/personal/tui.json"
  }
}
